# .npmrc — Configuración npm para compatibilidad cross-platform (Windows dev / Linux Vercel)
#
# Garantiza que los scripts de postinstall de paquetes nativos (como esbuild)
# se ejecuten siempre. Sin esto, el binario esbuild-linux-x64 no se descarga
# en el runner Linux de Vercel y el build falla con exit 126.
ignore-scripts=false
prefer-offline=false
